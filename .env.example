# Secret used to encrypt the login cookie. 32+ characters.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Supabase > Connect > Direct > Session pooler (port 5432).
# Use the Transaction pooler (port 6543) when deploying to Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API Keys. The secret key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
